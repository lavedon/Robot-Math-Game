<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MathRobot.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MathRobot.Core.Tests" />
    <InternalsVisibleTo Include="MathRobotGame" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pixel font ships inside this dll as "Art/font.txt". -->
    <EmbeddedResource Include="Art\**\*">
      <LogicalName>Art/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
